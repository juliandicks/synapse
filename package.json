{
  "name": "synapse-graph",
  "version": "0.1.1",
  "description": "Interactive canvas-based graph visualization for exploring relationships between entities",
  "type": "module",
  "keywords": [
    "graph",
    "visualization",
    "canvas",
    "interactive",
    "network"
  ],
  "homepage": "https://github.com/juliandicks/synapse#readme",
  "bugs": {
    "url": "https://github.com/juliandicks/synapse/issues"
  },
  "license": "MIT",
  "author": "Julian Dicks (https://github.com/juliandicks)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juliandicks/synapse.git"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "main": "dist/synapse.cjs",
  "module": "dist/synapse.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/synapse.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/synapse.cjs"
      }
    },
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "unpkg": "dist/synapse.cjs",
  "jsdelivr": "dist/synapse.cjs",
  "sideEffects": false,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:demo": "vite build --config vite.config.demo.ts",
    "preview": "vite preview --config vite.config.demo.ts",
    "test": "vitest run",
    "test:packaged": "node scripts/test-packaged.mjs",
    "test:watch": "vitest",
    "test:visual": "vite --config vite.config.test.ts",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "vite": "^6.4.3",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^3.2.6"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true
  }
}
